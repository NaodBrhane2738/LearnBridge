{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "redirects": [
    {
      "source": "/alx",
      "destination": "/alx/",
      "permanent": true
    },
    {
      "source": "/job-portal",
      "destination": "/job-portal/",
      "permanent": true
    },
    {
      "source": "/employment",
      "destination": "/employment/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/job-portal/",
      "destination": "/employment/index.html"
    },
    {
      "source": "/job-portal/(.*)",
      "destination": "/employment/$1"
    },
    {
      "source": "/employment/",
      "destination": "/employment/index.html"
    },
    {
      "source": "/employment/(.*)",
      "destination": "/employment/$1"
    },
    {
      "source": "/alx/",
      "destination": "/alx-test-website/frontend/index.html"
    },
    {
      "source": "/alx/(.*)",
      "destination": "/alx-test-website/frontend/$1"
    },
    {
      "source": "/anime-assistant/(.*)",
      "destination": "/alx-test-website/anime-assistant/$1"
    },
    {
      "source": "/studio",
      "destination": "/studio/index.html"
    },
    {
      "source": "/studio/(.*)",
      "destination": "/studio/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*).vtt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vtt; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*).json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*).wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    }
  ]
}
